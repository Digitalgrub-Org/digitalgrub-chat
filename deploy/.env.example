MATRIX_SERVER_NAME=chat.example.com
MATRIX_PUBLIC_HOST=chat.example.com
SYNAPSE_REPORT_STATS=no
SYNAPSE_ENABLE_REGISTRATION=true
SYNAPSE_REGISTRATION_REQUIRES_TOKEN=false

POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
CADDY_ACME_EMAIL=admin@example.com
TZ=UTC

# Push is optional. Start the stack with `--profile push` only after real FCM
# and APNs credentials are mounted into Sygnal; see docs/operations.md. Caddy
# already proxies /_matrix/push/v1/notify on MATRIX_PUBLIC_HOST, so the client
# uses https://${MATRIX_PUBLIC_HOST}/_matrix/push/v1/notify as its gateway URL.
# Never place FCM or APNs credentials in this file or anywhere in the repository.
